# ==============================================================================
# SENIORINSIGHT - TEMPLATE DE VARIÁVEIS DE AMBIENTE (LOCAL / DEV)
# ==============================================================================
# Para usar: copie este arquivo para .env na raiz do projeto:
#   cp template.env .env
# O docker-compose e o Spring Boot lerão essas variáveis automaticamente.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Perfil Spring Boot
# ------------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev

# ------------------------------------------------------------------------------
# 2. Servidor
# ------------------------------------------------------------------------------
SERVER_PORT=8080

# ------------------------------------------------------------------------------
# 3. Banco de Dados PostgreSQL (Local / Docker Compose)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=seniorinsight
DB_USERNAME=seniorinsight
DB_PASSWORD=seniorinsight

# ------------------------------------------------------------------------------
# 4. Cache Redis (Local / Docker Compose)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 5. Segurança: Keycloak
# ------------------------------------------------------------------------------
# Keycloak (realm seniorinsight): o care-service só valida o access token emitido por ele.
# Obrigatório: tem de ser igual à claim iss dos tokens.
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/seniorinsight
# Opcional: endereço do JWKS quando o issuer não é alcançável deste processo (ex.: dentro do Docker).
# Deixe comentado para descobrir o JWKS pelo issuer; vazio, o serviço não valida tokens.
# SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_JWKSETURI=http://keycloak:8080/realms/seniorinsight/protocol/openid-connect/certs

# ------------------------------------------------------------------------------
# 6. Integrações LLM (Opcional / Testes Locais)
# ------------------------------------------------------------------------------
LLM_OPENAI_BASE_URL=https://api.openai.com
LLM_OPENAI_API_KEY=
LLM_ANTHROPIC_BASE_URL=https://api.anthropic.com
LLM_ANTHROPIC_API_KEY=
LLM_GOOGLE_BASE_URL=https://generativelanguage.googleapis.com
LLM_GOOGLE_API_KEY=
